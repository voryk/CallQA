# Скопируйте в .env и заполните. Реальные секреты в Git не коммитить.
APP_ENV=local
SECRET_KEY=change-me-generate-random
ACCESS_TOKEN_TTL_MIN=60

POSTGRES_USER=callguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=callguard
DATABASE_URL=postgresql+psycopg://callguard:change-me@postgres:5432/callguard
REDIS_URL=redis://redis:6379/0

STORAGE_DIR=/data/storage
TEMP_DIR=/data/tmp
MODELS_DIR=/models
MAX_UPLOAD_MB=200
MAX_CALL_MINUTES=60
ALLOWED_FORMATS=wav,mp3,ogg

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ru

EVALUATION_ENGINE=rules        # rules | ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SEC=120

WORKER_CONCURRENCY=1
JOB_TIMEOUT_SEC=1800
JOB_MAX_RETRIES=2
STALE_JOB_AFTER_SEC=1800

RETENTION_AUDIO_DAYS=30
RETENTION_TRANSCRIPT_DAYS=90
OFFLINE_MODE=true
