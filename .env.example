# Скопируйте в .env и заполните. Реальный .env в Git не коммитить.
# Комментарии пишем отдельными строками: так их одинаково читают Docker Compose и Python.

# ---------- Приложение ----------
# local | test | production. В production запрещены шаблонные секреты.
APP_ENV=local
# Минимум 32 символа. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-random-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=60

# ---------- PostgreSQL ----------
POSTGRES_USER=callguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=callguard
# Внутри Docker хост называется postgres. Для запуска backend вне Docker замените на localhost.
DATABASE_URL=postgresql+psycopg://callguard:change-me@postgres:5432/callguard

# ---------- Redis / RQ ----------
REDIS_URL=redis://redis:6379/0

# ---------- Хранилище и модели ----------
# Хранилище вне статической директории; выдача файлов только через API.
STORAGE_DIR=/data/storage
TEMP_DIR=/data/tmp
MODELS_DIR=/models

# ---------- Загрузка ----------
MAX_UPLOAD_MB=200
MAX_CALL_MINUTES=60
# Через запятую
ALLOWED_FORMATS=wav,mp3,ogg

# ---------- Распознавание речи (faster-whisper) ----------
# tiny | base | small | medium. Выбор по замерам на целевом оборудовании.
WHISPER_MODEL=small
# Ноутбук без CUDA: cpu
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=ru

# ---------- Оценка качества ----------
# rules | ollama. Ollama необязателен, rules работает всегда.
EVALUATION_ENGINE=rules
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SEC=120

# ---------- Очередь ----------
# Один AI-worker по умолчанию: не запускаем несколько тяжёлых моделей одновременно.
WORKER_CONCURRENCY=1
JOB_TIMEOUT_SEC=1800
JOB_MAX_RETRIES=2
# Задача в processing без обновлений дольше этого срока считается зависшей.
STALE_JOB_AFTER_SEC=1800

# ---------- Хранение данных (дни) ----------
RETENTION_AUDIO_DAYS=30
RETENTION_TRANSCRIPT_DAYS=90

# ---------- Офлайн-режим ----------
# true: запрещаем загрузку моделей из сети (модели скачиваются заранее).
OFFLINE_MODE=true
