# --- Общие ---
APP_ENV=local
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./data/db/callqa.db
DATA_DIR=./data
MODELS_DIR=./models

# --- Загрузка ---
MAX_UPLOAD_MB=200
ALLOWED_FORMATS=wav,mp3,ogg
MAX_CALL_MINUTES=60

# --- STT ---
STT_ENGINE=whisper          # whisper | vosk
WHISPER_MODEL=small         # tiny | base | small | medium
WHISPER_DEVICE=auto         # auto | cpu | cuda
WHISPER_COMPUTE=int8
STT_LANGUAGE=ru

# --- LLM (локальная) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SEC=120

# --- Очередь ---
WORKER_CONCURRENCY=1
JOB_MAX_RETRIES=2
JOB_STALE_AFTER_SEC=900

# --- Безопасность ---
OFFLINE_MODE=true
ENCRYPT_AT_REST=false
AUDIO_TTL_DAYS=30
